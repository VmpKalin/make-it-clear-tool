{
  "name": "textpilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered text assistant — browser extension + desktop widget",
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "build:all": "pnpm -r build",
    "dev:extension": "pnpm --filter @textpilot/extension dev",
    "dev:desktop": "pnpm --filter @textpilot/desktop tauri dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
